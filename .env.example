# ---- Internal LLM (Qwen, gpt-oss-120b, ... behind an HTTP endpoint with a Bearer key) ----
# OpenAI-compatible base URL (the part before /chat/completions), e.g. https://llm.internal.example.com/v1
INTERNAL_LLM_URL=
INTERNAL_LLM_KEY=
INTERNAL_LLM_MODEL=
# openai = OpenAI-compatible /chat/completions (default) | custom = edit _build_payload/_parse_response in llm.py
INTERNAL_LLM_MODE=openai
# false = do not verify the TLS certificate (as requested). This exposes the Bearer key to interception;
# prefer pointing INTERNAL_LLM_CA_BUNDLE at your organisation's CA file and setting this back to true.
INTERNAL_LLM_VERIFY_SSL=false
INTERNAL_LLM_CA_BUNDLE=
INTERNAL_LLM_TIMEOUT=180

# What the LLM may see:
#   stats_only      = column names + statistics only, never cell values (default, recommended)
#   masked_samples  = also a few masked example values and "most common value changes"
LLM_DATA_MODE=stats_only

# ---- Org guardrails (monkey patches), imported BEFORE langchain / openai ----
GUARDRAILS_MODULE=
# Optional "module:function" called right after the import, e.g. my_org_guardrails:apply
GUARDRAILS_ENTRYPOINT=

# ---- Folders ----
WORK_DIR=work
OUTPUT_DIR=output

# ---- Performance (defaults are fine for 1M rows x 100 columns) ----
# Cap DuckDB memory, e.g. 8GB (empty = about 80% of RAM). It spills to WORK_DIR/tmp when it runs out.
DUCKDB_MEMORY_LIMIT=
DUCKDB_THREADS=0
# auto = fast reader (calamine, ~60 bytes of RAM per cell: ~6 GB for a 1M x 100 sheet) unless it would not fit in
# free RAM, then the slow low-memory reader (openpyxl). Or force: calamine | openpyxl.  CSV input is fastest.
EXCEL_READER=auto
CHUNK_ROWS=50000
# Columns compared per pass (lower = less memory)
BATCH_COLUMNS=20

# ---- Output ----
EXPORT_FORMAT=csv
MAX_DETAIL_PER_COLUMN=100000
REPORT_SAMPLE_ROWS=1000
